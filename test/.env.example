# WebRTC Test Configuration
# Copy this file to .env and adjust values as needed

# WebSocket URL of the Tekthib signaling server
# Examples:
#   - Local development: ws://localhost:3001
#   - Production: wss://your-server.com
SIGNALING_URL=ws://localhost:3001

# Room code to join (leave empty to create a new room)
# ROOM_CODE=TEST123

# Number of simulated peers to create
NUM_PEERS=4

# Prefix for player names (will be numbered: TestPeer1, TestPeer2, etc.)
PLAYER_PREFIX=TestPeer
